{
  "arrays": {
    "title": "Find the first duplicate",
    "text": "Write solve(values). Return the first number whose second occurrence is encountered when scanning left to right. Return null if all numbers are unique. Integers may be negative or zero. Maximum length: 100,000.",
    "signature": "function solve(values) {\n  // Your solution here\n}\n",
    "example": "[4, 2, 4, 2] → 4",
    "tests": [
      {
        "input": [
          4,
          2,
          4,
          2
        ],
        "expected": 4
      },
      {
        "input": [],
        "expected": null
      },
      {
        "input": [
          1,
          2,
          3
        ],
        "expected": null
      },
      {
        "input": [
          0,
          0
        ],
        "expected": 0
      },
      {
        "input": [
          -1,
          2,
          -1
        ],
        "expected": -1
      },
      {
        "input": [
          1,
          2,
          2,
          1
        ],
        "expected": 2
      },
      {
        "input": [
          7
        ],
        "expected": null
      },
      {
        "input": [
          5,
          5,
          5
        ],
        "expected": 5
      }
    ]
  },
  "strings": {
    "title": "Anagram check",
    "text": "Write solve([a, b]). Return true if both strings contain exactly the same letters with the same frequencies; otherwise false. Inputs contain only lowercase a–z and may be empty. Maximum combined length: 100,000.",
    "signature": "function solve([a, b]) {\n  // Your solution here\n}\n",
    "example": "[\"listen\", \"silent\"] → true",
    "tests": [
      {
        "input": [
          "listen",
          "silent"
        ],
        "expected": true
      },
      {
        "input": [
          "a",
          "b"
        ],
        "expected": false
      },
      {
        "input": [
          "",
          ""
        ],
        "expected": true
      },
      {
        "input": [
          "aab",
          "abb"
        ],
        "expected": false
      },
      {
        "input": [
          "abc",
          "ab"
        ],
        "expected": false
      },
      {
        "input": [
          "aaaa",
          "aaaa"
        ],
        "expected": true
      },
      {
        "input": [
          "abca",
          "caba"
        ],
        "expected": true
      },
      {
        "input": [
          "x",
          ""
        ],
        "expected": false
      }
    ]
  },
  "fastapi": {
    "title": "Configuration, without surprises",
    "text": "Write solve() with no arguments. Return a dictionary with app_name (str, default \"Duel API\"), port (int, default 8000), and debug (bool, default False). Read overrides from APP_NAME, PORT, and DEBUG using Pydantic Settings. Invalid PORT must raise a validation error.",
    "signature": "# pydantic-settings is available\nfrom pydantic_settings import BaseSettings\n\n# Define your settings class here\n\ndef solve():\n    pass\n",
    "example": "No environment overrides → {\"app_name\": \"Duel API\", \"port\": 8000, \"debug\": false}",
    "tests": []
  },
